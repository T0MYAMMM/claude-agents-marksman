# Backend configuration (prefix APP_). Copy to backend/.env for local dev.

# Database — async SQLite for dev, async Postgres for prod.
APP_DATABASE_URL=sqlite+aiosqlite:///./orchestrator.db
# APP_DATABASE_URL=postgresql+asyncpg://orchestrator:password@localhost:5432/orchestrator

# Tailscale CGNAT range. Only requests from this network are accepted.
# Set empty to disable the network guard (NOT for production).
APP_TAILSCALE_CIDR=100.64.0.0/10

# Google Drive service-account credentials. Provide ONE of the two.
# Path takes precedence if both are set. NEVER commit the key itself.
#   Option A — file path (local dev / mounted secret):
APP_GDRIVE_CREDENTIALS_PATH=/secrets/gdrive-sa.json
#   Option B — inline JSON (secret managers / containers); paste the whole key on one line:
# APP_GDRIVE_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}
#
# Reminder: share the target Drive folder with the service account's client_email
# (Editor), and use that folder's ID as the project's gdrive_folder_id.
#
#   Option C — OAuth user token (REQUIRED for a personal Google account, since a service
#   account cannot store bytes there). Authorize once with:
#     python -m scripts.gdrive_oauth --client-secret /secrets/oauth-client.json \
#         --token ./secrets/oauth-token.json
#   then point the backend at the token (takes precedence over the SA):
# APP_GDRIVE_OAUTH_TOKEN_PATH=/app/secrets/oauth-token.json

# Default commit-timeline page size.
APP_DEFAULT_PAGE_SIZE=50
