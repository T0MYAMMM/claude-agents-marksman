# Backend configuration (prefix APP_). For deployment: `cp backend/.env.example backend/.env`
# and fill in. This file is read by docker-compose (env_file). NEVER commit backend/.env.

# --- Database ---
# Async Postgres in prod (Neon, RDS, self-hosted, …). Provider connection strings work
# verbatim — the app normalizes them (coerces to +asyncpg, applies SSL, strips libpq-only
# params like sslmode/channel_binding).
APP_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# Neon example (paste theirs as-is):
# APP_DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# --- Network guard ---
# Comma-separated trusted CIDRs. Keep the Docker bridge (172.16.0.0/12) so the containerized
# frontend can call the API server-side. Keep the Tailscale range (100.64.0.0/10) if agents
# connect over a tailnet. For a public VPS behind a reverse proxy, set this to "" and rely on
# the per-agent API key + your proxy's auth. (docker-compose also sets this — env there wins.)
APP_TAILSCALE_CIDR=100.64.0.0/10,172.16.0.0/12

# --- Google Drive credentials (provide ONE; OAuth is required for a personal Google account) ---
# Place all secret files in the gitignored ./secrets dir (mounted to /app/secrets).
#
# OAuth user token (recommended). Authorize once on a machine with a browser:
#   python -m scripts.gdrive_oauth --client-secret ./secrets/oauth-client.json \
#       --token ./secrets/oauth-token.json
APP_GDRIVE_OAUTH_TOKEN_PATH=/app/secrets/oauth-token.json
#
# OR a service-account key (only works on a Workspace Shared Drive — no quota on personal):
# APP_GDRIVE_CREDENTIALS_PATH=/app/secrets/gdrive-sa.json
# APP_GDRIVE_CREDENTIALS_JSON={"type":"service_account", ...}   # inline alternative

# --- Markdown-editing chat assistant (optional) ---
# Anthropic API key enables the Edit-with-AI panel; leave empty to disable (endpoint 503s).
APP_ANTHROPIC_API_KEY=

# --- Misc ---
APP_DEFAULT_PAGE_SIZE=50
